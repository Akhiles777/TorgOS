[Unit]
Description=go2rtc (ТоргОС — камеры)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{INSTALL_DIR}}/go2rtc -config {{INSTALL_DIR}}/go2rtc.yaml
WorkingDirectory={{INSTALL_DIR}}
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
