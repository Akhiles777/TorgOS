generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgType {
  RETAIL
  HORECA
}

enum Plan {
  TRIAL
  BASIC
  PRO
}

enum Role {
  OWNER
  ADMIN
  CASHIER
}

enum Unit {
  PCS
  KG
}

enum MovementType {
  IN
  OUT
  WRITEOFF
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

// Статус подписки. Пока нет реального эквайринга: PAST_DUE/SUSPENDED —
// результат автоматической ежедневной проверки (истёк триал и т.д.), не
// оплаты. ACTIVE недостижим до подключения реального биллинга — оставлен
// для будущего, чтобы схему не пришлось трогать повторно.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

// Тип события анонимного посетителя лендинга (не путать с бизнес-событиями
// внутри приложения) — см. SiteEvent ниже.
enum SiteEventType {
  PAGEVIEW
  SCROLL_25
  SCROLL_50
  SCROLL_75
  SCROLL_100
  CTA_CLICK
}

model Organization {
  id         String      @id @default(cuid())
  name       String
  type       OrgType
  // plan — он же «currentPlan» из брифа: тариф организации. Отдельного
  // одноимённого поля не заводим, было бы дублированием.
  plan       Plan        @default(TRIAL)
  createdAt  DateTime    @default(now())
  stores     Store[]
  users      User[]
  aiBriefing AiBriefing?

  // Биллинг-каркас (без реального списания денег — см. server/guard.ts::assertSubscriptionActive)
  subscriptionStatus  SubscriptionStatus @default(TRIAL)
  trialEndsAt         DateTime?
  pastDueSince        DateTime?
  nextPaymentAt       DateTime?
  trialReminderSentAt DateTime?
}

model Store {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  address           String
  // Город — для супер-админки (фильтр/поиск) и регионализации; отдельно от
  // address, который остаётся полной строкой адреса.
  city              String?
  // IANA-зона точки, для расчёта кассового дня (server/services/shift.ts)
  // и отображения дат/времени в местном времени владельца.
  timezone          String             @default("Europe/Moscow")
  users             User[]
  products          Product[]
  sales             Sale[]
  suppliers         Supplier[]
  employees         Employee[]
  shifts            Shift[]
  inventorySessions InventorySession[]
  importBatches     ImportBatch[]
  storeAgents       StoreAgent[]
  cameraDevices     CameraDevice[]

  @@index([organizationId])
}

// Сотрудник смены — тот, кто физически стоит на кассе (Земфира, Рита…).
// НЕ логин-аккаунт: касса работает под одной учёткой, а «кто на смене»
// выбирается одним тапом. Продажи атрибутируются на этого сотрудника.
model Employee {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  shifts    Shift[]
  sales     Sale[]

  @@index([storeId])
}

// Смена — кто выбран «за управлением» в конкретный кассовый день.
// Кассовый день считается по границе 07:00 МСК (shiftDay = "YYYY-MM-DD").
model Shift {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftDay   String
  createdAt  DateTime @default(now())

  @@index([storeId, shiftDay])
}

model User {
  id                       String             @id @default(cuid())
  organizationId           String
  organization             Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeId                  String?
  store                    Store?             @relation(fields: [storeId], references: [id])
  role                     Role
  name                     String
  login                    String             @unique
  passwordHash             String
  createdAt                DateTime           @default(now())
  sessions                 Session[]
  sales                    Sale[]
  movements                StockMovement[]
  inventorySessionsStarted InventorySession[]
  importBatches            ImportBatch[]

  // Самостоятельная регистрация (/register): email = логин владельца.
  // Nullable — у сотрудников, заведённых владельцем внутри кабинета,
  // почты может не быть вовсе.
  email                    String?   @unique
  emailVerifiedAt          DateTime?
  emailVerifyCode          String?
  emailVerifyCodeExpiresAt DateTime?

  @@index([organizationId])
}

// id — sha256-хэш токена; сам токен живёт только в cookie
model Session {
  id                         String   @id
  userId                     String
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt                  DateTime
  // Если задано — эта сессия создана супер-админом через «войти как» (impersonation),
  // не логином пользователя. AppShell показывает баннер с кнопкой возврата.
  // Прямой relation на SuperAdmin не заводим (это единственная связь обычных
  // моделей с супер-админскими — держим её слабой, по id, чтобы не тянуть
  // SuperAdmin в tenant-граф).
  impersonatedBySuperAdminId String?
}

model Product {
  id             String          @id @default(cuid())
  storeId        String
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  barcode        String?
  name           String
  price          Decimal         @db.Decimal(10, 2)
  costPrice      Decimal         @db.Decimal(10, 2)
  unit           Unit            @default(PCS)
  category       String
  expiry         DateTime?
  stock          Decimal         @default(0) @db.Decimal(10, 3)
  isActive       Boolean         @default(true)
  // Показывать плиткой в правом меню кассы (для товаров без штрихкода или
  // тех, что неудобно сканировать — тяжёлые бутылки воды и т.п.). По умолчанию
  // выключено: касса работает сканером, а плитки — только для избранного.
  showInPos      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  movements      StockMovement[]
  saleItems      SaleItem[]
  inventoryLines InventoryLine[]
  // Проставляется только при СОЗДАНИИ товара импортом — не при обновлении уже
  // существующей позиции (дедуп «обновить цену»/«обновить всё»). Иначе откат
  // импорта удалил бы товар, который существовал до импорта. См. ImportBatch.
  importBatchId  String?

  @@unique([storeId, barcode])
  @@index([storeId, category])
  @@index([importBatchId])
}

// Один запуск импорта номенклатуры из файла (app/admin/import/). rowsImported
// считает только СОЗДАННЫЕ товары (у них Product.importBatchId = этот id);
// обновлённые существующие позиции в счётчик тоже входят, но не помечаются —
// откат (rollbackBatch) удаляет только добавленное, не трогает обновлённое.
model ImportBatch {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  fileName     String
  rowsTotal    Int
  rowsImported Int       @default(0)
  rowsSkipped  Int       @default(0)
  aiChecked    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  rolledBackAt DateTime?

  @@index([storeId, createdAt])
}

model StockMovement {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      MovementType
  quantity  Decimal      @db.Decimal(10, 3)
  reason    String?
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([productId, createdAt])
}

model Sale {
  id            String        @id @default(cuid())
  number        Int           @default(autoincrement())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashierId     String
  cashier       User          @relation(fields: [cashierId], references: [id])
  // Сотрудник смены, на которого записана продажа (кто был «за управлением»).
  // Nullable: старые чеки и продажи без выбранной смены.
  employeeId    String?
  employee      Employee?     @relation(fields: [employeeId], references: [id])
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  cashGiven     Decimal?      @db.Decimal(10, 2)
  changeGiven   Decimal?      @db.Decimal(10, 2)
  // Продажа «в долг»: чек пробит, но деньги ещё не получены. Попадает в раздел
  // «Долги». debtPaidAt заполняется, когда долг погашен. Имя/контакт — опционально.
  isDebt        Boolean       @default(false)
  debtorName    String?
  debtorContact String?
  debtPaidAt    DateTime?
  createdAt     DateTime      @default(now())
  items         SaleItem[]

  @@index([storeId, createdAt])
  @@index([employeeId])
  @@index([storeId, isDebt, debtPaidAt])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Decimal @db.Decimal(10, 3)
  priceAtSale Decimal @db.Decimal(10, 2)

  @@index([productId])
}

// Кеш ИИ-сводки владельца: одна запись на организацию (кабинет владельца
// агрегирует ВСЕ точки организации, поэтому ключ — organizationId, не storeId),
// перегенерируется по TTL. Разделено с рекомендациями-правилами (Insight) —
// эта сводка неточная/сгенерированная, правила остаются источником истины
// и работают даже если ИИ недоступен.
model AiBriefing {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  content        String
  model          String
  generatedAt    DateTime     @default(now())
}

model Supplier {
  id      String  @id @default(cuid())
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name    String
  phone   String?
  notes   String?

  @@index([storeId])
}

// ── Инвентаризация ──────────────────────────────────────────────────────
// Пересчёт остатков по точке: сканируешь товар, вводишь фактическое
// количество, в конце — отчёт по расхождениям и кнопка «Применить»
// (создаёт StockMovement на каждую расходящуюся строку).
model InventorySession {
  id          String          @id @default(cuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  startedById String
  startedBy   User            @relation(fields: [startedById], references: [id])
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  lines       InventoryLine[]

  @@index([storeId, startedAt])
}

model InventoryLine {
  id          String           @id @default(cuid())
  sessionId   String
  session     InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product          @relation(fields: [productId], references: [id])
  // Остаток по базе на момент скана — фиксируется сразу, чтобы параллельная
  // продажа на кассе не «съела» разницу, пока считаем.
  expectedQty Decimal          @db.Decimal(10, 3)
  countedQty  Decimal          @db.Decimal(10, 3)
  countedAt   DateTime         @default(now())

  @@unique([sessionId, productId])
  @@index([sessionId])
}

// ── Супер-админка (уровень выше организаций, только для основателя) ────
// Полностью отдельный стек аутентификации: своя кука (torgos_root_session),
// свои сессии, ноль пересечений с обычными User/Session. Через /register
// такую учётку создать нельзя — только скриптом `npm run create-superadmin`.
// Единственное место в проекте, где код намеренно работает с сырым `prisma`,
// а не tenantDb — супер-админу по определению нужен доступ ко всем организациям.
model SuperAdmin {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  name         String
  createdAt    DateTime             @default(now())
  lastLoginAt  DateTime?
  sessions     SuperAdminSession[]
  auditLogs    SuperAdminAuditLog[]
}

model SuperAdminSession {
  id           String     @id // sha256(токена) — та же схема, что у обычной Session
  superAdminId String
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
}

// Только для чтения даже мной — журнал действий супер-админа: смена тарифа,
// продление триала, приостановка/удаление организации, impersonation,
// сброс пароля. targetType/targetId — полиморфная ссылка (Organization/User).
model SuperAdminAuditLog {
  id           String     @id @default(cuid())
  superAdminId String
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id])
  action       String
  targetType   String
  targetId     String
  meta         Json?
  createdAt    DateTime   @default(now())

  @@index([superAdminId, createdAt])
  @@index([targetType, targetId])
}

// ── Аналитика публичного лендинга (анонимные посетители) ───────────────
// Никакой связи с Organization/User намеренно — посетитель не идентифицирован
// и не связан с последующей регистрацией (см. отчёт по фиче: конверсия
// считается как два параллельных числа за период, а не как цепочка кликов
// одного человека). sessionId живёт только в sessionStorage браузера —
// обнуляется с закрытием вкладки, не постоянный трекинг-cookie.
model SiteEvent {
  id        String        @id @default(cuid())
  type      SiteEventType
  sessionId String
  path      String
  referrer  String?
  utmSource String?
  device    String?
  cta       String?
  createdAt DateTime      @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
  @@index([path, createdAt])
}

// Кеш ИИ-сводки для супер-админа — платформенный аналог AiBriefing, но без
// ключа по организации (это про весь SaaS сразу), поэтому singleton-запись
// с фиксированным id вместо @unique на внешний ключ.
model PlatformBriefing {
  id          String   @id @default("platform")
  content     String
  model       String
  generatedAt DateTime @default(now())
}

// ── Камеры ───────────────────────────────────────────────────────────────
// Регистратор в магазине сидит за NAT провайдера, порты наружу не открываем
// (см. отчёт по фиче) — StoreAgent представляет мини-ПК/Raspberry Pi на
// месте, который сам инициирует исходящее соединение к нашему серверу и
// локально гоняет go2rtc против регистратора. CameraDevice.connection=DIRECT
// (клиент с белым IP, сам открыл порт) вообще не использует агента —
// agentId в этом случае пуст, проверяется в сервисном слое, не в БД.
enum CameraVendor {
  DAHUA
  HIKVISION
  GENERIC
}

enum CameraConnectionMode {
  AGENT
  DIRECT
}

enum AgentStatus {
  PENDING
  ONLINE
  OFFLINE
}

// tokenHash = sha256(токена) — та же схема, что Session/SuperAdminSession:
// сырой токен показывается в интерфейсе один раз при выпуске и живёт только
// в install-команде для агента, в БД остаётся только хеш.
model StoreAgent {
  id           String         @id @default(cuid())
  storeId      String
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  tokenHash    String         @unique
  status       AgentStatus    @default(PENDING)
  lastSeenAt   DateTime?
  lastIp       String?
  agentVersion String?
  createdAt    DateTime       @default(now())
  devices      CameraDevice[]

  @@index([storeId])
}

model CameraDevice {
  id         String               @id @default(cuid())
  storeId    String
  store      Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  vendor     CameraVendor
  connection CameraConnectionMode @default(AGENT)
  agentId    String?
  agent      StoreAgent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  host       String
  rtspPort   Int                  @default(554)
  httpPort   Int                  @default(80)
  username   String
  // Шифруется server/cameraCrypto.ts (AES-256-GCM) — чужое оборудование в
  // чужом магазине, пароль в открытом виде в БД лежать не должен.
  passwordEnc    String
  channelCount   Int              @default(1)
  // Escape hatch для GENERIC/нестандартных прошивок — прямые URL руками,
  // когда шаблон по вендору не подходит (lib/cameraVendors.ts).
  urlOverride    Json?
  // Дрейф часов регистратора — считается по требованию (при сохранении +
  // кнопка «проверить снова»), не по таймеру, см. отчёт по фиче.
  clockOffsetSec Int?
  clockCheckedAt DateTime?
  createdAt      DateTime         @default(now())
  cameras        Camera[]

  @@index([storeId])
  @@index([agentId])
}

model Camera {
  id        String       @id @default(cuid())
  deviceId  String
  device    CameraDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  channel   Int
  name      String
  enabled   Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@unique([deviceId, channel])
  @@index([deviceId])
}
