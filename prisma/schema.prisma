generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgType {
  RETAIL
  HORECA
}

enum Plan {
  TRIAL
  BASIC
  PRO
}

enum Role {
  OWNER
  ADMIN
  CASHIER
}

enum Unit {
  PCS
  KG
  // Граммы/мл/литры — единицы ингредиентов в рецептах общепита (см. RecipeLine).
  // Розничные Product всегда PCS/KG, эти значения для них недостижимы.
  G
  ML
  L
}

// Статус заказа общепита (открытая «комната» до оплаты — не путать с чеком/Sale,
// который создаётся только в момент оплаты). См. модель Order.
enum OrderStatus {
  OPEN
  COOKING
  SERVED
  PAID
  CANCELLED
}

enum MovementType {
  IN
  OUT
  WRITEOFF
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

// Статус подписки. Пока нет реального эквайринга: PAST_DUE/SUSPENDED —
// результат автоматической ежедневной проверки (истёк триал и т.д.), не
// оплаты. ACTIVE недостижим до подключения реального биллинга — оставлен
// для будущего, чтобы схему не пришлось трогать повторно.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

// Тип события анонимного посетителя лендинга (не путать с бизнес-событиями
// внутри приложения) — см. SiteEvent ниже.
enum SiteEventType {
  PAGEVIEW
  SCROLL_25
  SCROLL_50
  SCROLL_75
  SCROLL_100
  CTA_CLICK
}

model Organization {
  id         String      @id @default(cuid())
  name       String
  type       OrgType
  // plan — он же «currentPlan» из брифа: тариф организации. Отдельного
  // одноимённого поля не заводим, было бы дублированием.
  plan       Plan        @default(TRIAL)
  createdAt  DateTime    @default(now())
  stores     Store[]
  users      User[]
  aiBriefing AiBriefing?

  // Биллинг-каркас (без реального списания денег — см. server/guard.ts::assertSubscriptionActive)
  subscriptionStatus  SubscriptionStatus @default(TRIAL)
  trialEndsAt         DateTime?
  pastDueSince        DateTime?
  nextPaymentAt       DateTime?
  trialReminderSentAt DateTime?
}

model Store {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  address           String
  // Город — для супер-админки (фильтр/поиск) и регионализации; отдельно от
  // address, который остаётся полной строкой адреса.
  city              String?
  // IANA-зона точки, для расчёта кассового дня (server/services/shift.ts)
  // и отображения дат/времени в местном времени владельца.
  timezone          String             @default("Europe/Moscow")
  users             User[]
  products          Product[]
  sales             Sale[]
  suppliers         Supplier[]
  employees         Employee[]
  shifts            Shift[]
  inventorySessions InventorySession[]
  importBatches     ImportBatch[]
  storeAgents       StoreAgent[]
  cameraDevices     CameraDevice[]
  // ── Общепит (HORECA) ── для RETAIL-организаций эти отношения всегда пусты.
  menuCategories    MenuCategory[]
  menuItems         MenuItem[]
  modifierGroups    ModifierGroup[]
  orders            Order[]
  productionDocs    ProductionDoc[]

  @@index([organizationId])
}

// Сотрудник смены — тот, кто физически стоит на кассе (Земфира, Рита…).
// НЕ логин-аккаунт: касса работает под одной учёткой, а «кто на смене»
// выбирается одним тапом. Продажи атрибутируются на этого сотрудника.
model Employee {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  shifts    Shift[]
  sales     Sale[]
  orders    Order[]

  @@index([storeId])
}

// Смена — кто выбран «за управлением» в конкретный кассовый день.
// Кассовый день считается по границе 07:00 МСК (shiftDay = "YYYY-MM-DD").
model Shift {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftDay   String
  createdAt  DateTime @default(now())

  @@index([storeId, shiftDay])
}

model User {
  id                       String             @id @default(cuid())
  organizationId           String
  organization             Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeId                  String?
  store                    Store?             @relation(fields: [storeId], references: [id])
  role                     Role
  name                     String
  login                    String             @unique
  passwordHash             String
  createdAt                DateTime           @default(now())
  sessions                 Session[]
  sales                    Sale[]
  movements                StockMovement[]
  inventorySessionsStarted InventorySession[]
  importBatches            ImportBatch[]
  orders                   Order[]
  productionDocs           ProductionDoc[]

  // Самостоятельная регистрация (/register): email = логин владельца.
  // Nullable — у сотрудников, заведённых владельцем внутри кабинета,
  // почты может не быть вовсе.
  email                    String?   @unique
  emailVerifiedAt          DateTime?
  emailVerifyCode          String?
  emailVerifyCodeExpiresAt DateTime?

  @@index([organizationId])
}

// id — sha256-хэш токена; сам токен живёт только в cookie
model Session {
  id                         String   @id
  userId                     String
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt                  DateTime
  // Если задано — эта сессия создана супер-админом через «войти как» (impersonation),
  // не логином пользователя. AppShell показывает баннер с кнопкой возврата.
  // Прямой relation на SuperAdmin не заводим (это единственная связь обычных
  // моделей с супер-админскими — держим её слабой, по id, чтобы не тянуть
  // SuperAdmin в tenant-граф).
  impersonatedBySuperAdminId String?
}

model Product {
  id             String          @id @default(cuid())
  storeId        String
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  barcode        String?
  name           String
  price          Decimal         @db.Decimal(10, 2)
  costPrice      Decimal         @db.Decimal(10, 2)
  unit           Unit            @default(PCS)
  category       String
  expiry         DateTime?
  stock          Decimal         @default(0) @db.Decimal(10, 3)
  isActive       Boolean         @default(true)
  // Показывать плиткой в правом меню кассы (для товаров без штрихкода или
  // тех, что неудобно сканировать — тяжёлые бутылки воды и т.п.). По умолчанию
  // выключено: касса работает сканером, а плитки — только для избранного.
  showInPos      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  movements      StockMovement[]
  saleItems      SaleItem[]
  inventoryLines InventoryLine[]
  // Проставляется только при СОЗДАНИИ товара импортом — не при обновлении уже
  // существующей позиции (дедуп «обновить цену»/«обновить всё»). Иначе откат
  // импорта удалил бы товар, который существовал до импорта. См. ImportBatch.
  importBatchId  String?
  // Полуфабрикат общепита (тесто, соус, сироп) — сам имеет рецепт (ownRecipe)
  // и производится через ProductionDoc, а не покупается напрямую. Для розницы
  // всегда false — флаг выставляется только на экране /admin/recipes.
  isSemiFinished    Boolean          @default(false)
  // ── Общепит (HORECA) ── для RETAIL-организаций все отношения ниже всегда пусты.
  recipeUsages      RecipeLine[]     @relation("RecipeIngredient")
  ownRecipe         RecipeLine[]     @relation("SemiProductRecipe")
  modifierAdds      Modifier[]       @relation("ModifierAdd")
  modifierReplaces  Modifier[]       @relation("ModifierReplace")
  productionDocs    ProductionDoc[]
  productionLines   ProductionLine[]

  @@unique([storeId, barcode])
  @@index([storeId, category])
  @@index([importBatchId])
}

// Один запуск импорта номенклатуры из файла (app/admin/import/). rowsImported
// считает только СОЗДАННЫЕ товары (у них Product.importBatchId = этот id);
// обновлённые существующие позиции в счётчик тоже входят, но не помечаются —
// откат (rollbackBatch) удаляет только добавленное, не трогает обновлённое.
model ImportBatch {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  fileName     String
  rowsTotal    Int
  rowsImported Int       @default(0)
  rowsSkipped  Int       @default(0)
  aiChecked    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  rolledBackAt DateTime?

  @@index([storeId, createdAt])
}

model StockMovement {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      MovementType
  quantity  Decimal      @db.Decimal(10, 3)
  reason    String?
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([productId, createdAt])
}

model Sale {
  id            String        @id @default(cuid())
  number        Int           @default(autoincrement())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashierId     String
  cashier       User          @relation(fields: [cashierId], references: [id])
  // Сотрудник смены, на которого записана продажа (кто был «за управлением»).
  // Nullable: старые чеки и продажи без выбранной смены.
  employeeId    String?
  employee      Employee?     @relation(fields: [employeeId], references: [id])
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  cashGiven     Decimal?      @db.Decimal(10, 2)
  changeGiven   Decimal?      @db.Decimal(10, 2)
  // Продажа «в долг»: чек пробит, но деньги ещё не получены. Попадает в раздел
  // «Долги». debtPaidAt заполняется, когда долг погашен. Имя/контакт — опционально.
  isDebt        Boolean       @default(false)
  debtorName    String?
  debtorContact String?
  debtPaidAt    DateTime?
  // Возвраты. Сумма возвращённых по этому чеку денег: чек не удаляется и не
  // переписывается — история продаж должна оставаться неизменной, а возврат
  // это отдельное событие поверх неё. Ноль = возвратов не было.
  returnedTotal Decimal       @default(0) @db.Decimal(10, 2)
  returnedAt    DateTime?
  createdAt     DateTime      @default(now())
  items         SaleItem[]
  // Общепит: если продажа пришла из заказа (оплата в HORECA-режиме кассы),
  // строки чека — в order.items (OrderItem), а НЕ в SaleItem (items выше
  // остаётся пустым). Для розницы order всегда null. См. Order.saleId.
  order         Order?

  @@index([storeId, createdAt])
  @@index([employeeId])
  @@index([storeId, isDebt, debtPaidAt])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Decimal @db.Decimal(10, 3)
  priceAtSale Decimal @db.Decimal(10, 2)
  // Сколько из этой строки уже вернули. Возврат бывает частичным (взяли 3,
  // вернули 1), поэтому храним количество, а не флаг.
  returnedQty Decimal @default(0) @db.Decimal(10, 3)

  @@index([productId])
}

// Кеш ИИ-сводки владельца: одна запись на организацию (кабинет владельца
// агрегирует ВСЕ точки организации, поэтому ключ — organizationId, не storeId),
// перегенерируется по TTL. Разделено с рекомендациями-правилами (Insight) —
// эта сводка неточная/сгенерированная, правила остаются источником истины
// и работают даже если ИИ недоступен.
model AiBriefing {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  content        String
  model          String
  generatedAt    DateTime     @default(now())
}

model Supplier {
  id      String  @id @default(cuid())
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name    String
  phone   String?
  notes   String?

  @@index([storeId])
}

// ── Инвентаризация ──────────────────────────────────────────────────────
// Пересчёт остатков по точке: сканируешь товар, вводишь фактическое
// количество, в конце — отчёт по расхождениям и кнопка «Применить»
// (создаёт StockMovement на каждую расходящуюся строку).
model InventorySession {
  id          String          @id @default(cuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  startedById String
  startedBy   User            @relation(fields: [startedById], references: [id])
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  lines       InventoryLine[]

  @@index([storeId, startedAt])
}

model InventoryLine {
  id          String           @id @default(cuid())
  sessionId   String
  session     InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product          @relation(fields: [productId], references: [id])
  // Остаток по базе на момент скана — фиксируется сразу, чтобы параллельная
  // продажа на кассе не «съела» разницу, пока считаем.
  expectedQty Decimal          @db.Decimal(10, 3)
  countedQty  Decimal          @db.Decimal(10, 3)
  countedAt   DateTime         @default(now())

  @@unique([sessionId, productId])
  @@index([sessionId])
}

// ── Супер-админка (уровень выше организаций, только для основателя) ────
// Полностью отдельный стек аутентификации: своя кука (torgos_root_session),
// свои сессии, ноль пересечений с обычными User/Session. Через /register
// такую учётку создать нельзя — только скриптом `npm run create-superadmin`.
// Единственное место в проекте, где код намеренно работает с сырым `prisma`,
// а не tenantDb — супер-админу по определению нужен доступ ко всем организациям.
model SuperAdmin {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  name         String
  createdAt    DateTime             @default(now())
  lastLoginAt  DateTime?
  sessions     SuperAdminSession[]
  auditLogs    SuperAdminAuditLog[]
}

model SuperAdminSession {
  id           String     @id // sha256(токена) — та же схема, что у обычной Session
  superAdminId String
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
}

// Только для чтения даже мной — журнал действий супер-админа: смена тарифа,
// продление триала, приостановка/удаление организации, impersonation,
// сброс пароля. targetType/targetId — полиморфная ссылка (Organization/User).
model SuperAdminAuditLog {
  id           String     @id @default(cuid())
  superAdminId String
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id])
  action       String
  targetType   String
  targetId     String
  meta         Json?
  createdAt    DateTime   @default(now())

  @@index([superAdminId, createdAt])
  @@index([targetType, targetId])
}

// ── Аналитика публичного лендинга (анонимные посетители) ───────────────
// Никакой связи с Organization/User намеренно — посетитель не идентифицирован
// и не связан с последующей регистрацией (см. отчёт по фиче: конверсия
// считается как два параллельных числа за период, а не как цепочка кликов
// одного человека). sessionId живёт только в sessionStorage браузера —
// обнуляется с закрытием вкладки, не постоянный трекинг-cookie.
model SiteEvent {
  id        String        @id @default(cuid())
  type      SiteEventType
  sessionId String
  path      String
  referrer  String?
  utmSource String?
  device    String?
  cta       String?
  createdAt DateTime      @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
  @@index([path, createdAt])
}

// Заявка в лист ожидания общепита — платформенная сущность, не организация.
model Lead {
  id            String   @id @default(cuid())
  name          String
  contact       String
  contactType   String
  venueType     String
  city          String
  pointsCount   String
  currentSystem String
  painPoint     String?
  readyToCall   Boolean  @default(false)
  source        String?
  createdAt     DateTime @default(now())
  contactedAt   DateTime?
  note          String?

  @@index([createdAt])
  @@index([venueType])
  @@index([city])
  @@index([readyToCall])
}

// Кеш ИИ-сводки для супер-админа — платформенный аналог AiBriefing, но без
// ключа по организации (это про весь SaaS сразу), поэтому singleton-запись
// с фиксированным id вместо @unique на внешний ключ.
model PlatformBriefing {
  id          String   @id @default("platform")
  content     String
  model       String
  generatedAt DateTime @default(now())
}

// ── Камеры ───────────────────────────────────────────────────────────────
// Регистратор в магазине сидит за NAT провайдера, порты наружу не открываем
// (см. отчёт по фиче) — StoreAgent представляет мини-ПК/Raspberry Pi на
// месте, который сам инициирует исходящее соединение к нашему серверу и
// локально гоняет go2rtc против регистратора. CameraDevice.connection=DIRECT
// (клиент с белым IP, сам открыл порт) вообще не использует агента —
// agentId в этом случае пуст, проверяется в сервисном слое, не в БД.
enum CameraVendor {
  DAHUA
  HIKVISION
  GENERIC
}

enum CameraConnectionMode {
  AGENT
  DIRECT
}

enum AgentStatus {
  PENDING
  ONLINE
  OFFLINE
}

// tokenHash = sha256(токена) — та же схема, что Session/SuperAdminSession:
// сырой токен показывается в интерфейсе один раз при выпуске и живёт только
// в install-команде для агента, в БД остаётся только хеш.
model StoreAgent {
  id           String         @id @default(cuid())
  storeId      String
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  tokenHash    String         @unique
  status       AgentStatus    @default(PENDING)
  lastSeenAt   DateTime?
  lastIp       String?
  agentVersion String?
  createdAt    DateTime       @default(now())
  devices      CameraDevice[]

  @@index([storeId])
}

model CameraDevice {
  id         String               @id @default(cuid())
  storeId    String
  store      Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  vendor     CameraVendor
  connection CameraConnectionMode @default(AGENT)
  agentId    String?
  agent      StoreAgent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  host       String
  rtspPort   Int                  @default(554)
  httpPort   Int                  @default(80)
  username   String
  // Шифруется server/cameraCrypto.ts (AES-256-GCM) — чужое оборудование в
  // чужом магазине, пароль в открытом виде в БД лежать не должен.
  passwordEnc    String
  channelCount   Int              @default(1)
  // Escape hatch для GENERIC/нестандартных прошивок — прямые URL руками,
  // когда шаблон по вендору не подходит (lib/cameraVendors.ts).
  urlOverride    Json?
  // Дрейф часов регистратора — считается по требованию (при сохранении +
  // кнопка «проверить снова»), не по таймеру, см. отчёт по фиче.
  clockOffsetSec Int?
  clockCheckedAt DateTime?
  createdAt      DateTime         @default(now())
  cameras        Camera[]

  @@index([storeId])
  @@index([agentId])
}

model Camera {
  id        String       @id @default(cuid())
  deviceId  String
  device    CameraDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  channel   Int
  name      String
  enabled   Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@unique([deviceId, channel])
  @@index([deviceId])
}

// ── Общепит (HORECA) ───────────────────────────────────────────────────────
// Кафе продаёт блюдо (MenuItem), а списывает по рецепту ингредиенты (обычные
// Product-строки) — не само блюдо. Для RETAIL-организаций все модели этого
// блока всегда остаются пустыми (org.type проверяется на уровне UI/сервисов,
// не в БД — см. server/org.ts). См. отчёт по фиче для деталей решений.

model MenuCategory {
  id        String     @id @default(cuid())
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  position  Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  items     MenuItem[]

  @@unique([storeId, name])
  @@index([storeId, position])
}

model MenuItem {
  id             String                  @id @default(cuid())
  storeId        String
  store          Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       MenuCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  price          Decimal                 @db.Decimal(10, 2)
  isActive       Boolean                 @default(true)
  position       Int                     @default(0)
  // null = рецепт не задан (это НЕ ноль: 0 означает «рецепт есть, ингредиенты
  // бесплатны»). Пересчитывается server/services/horeca/costing.ts.
  cachedCost     Decimal?                @db.Decimal(10, 2)
  cachedCostAt   DateTime?
  createdAt      DateTime                @default(now())
  recipe         RecipeLine[]
  modifierGroups MenuItemModifierGroup[]
  orderItems     OrderItem[]

  @@index([storeId, isActive])
  @@index([categoryId, position])
}

// Общая, переиспользуемая группа модификаторов (молоко/сироп/размер) — не
// привязана к одному блюду, привязка — через MenuItemModifierGroup ниже.
model ModifierGroup {
  id         String                   @id @default(cuid())
  storeId    String
  store      Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  isRequired Boolean                  @default(false)
  maxChoices Int                      @default(1)
  createdAt  DateTime                 @default(now())
  modifiers  Modifier[]
  menuItems  MenuItemModifierGroup[]

  @@index([storeId])
}

// Привязка группы модификаторов к конкретному блюду (многие-ко-многим) +
// порядок показа группы именно в этом блюде.
model MenuItemModifierGroup {
  id         String        @id @default(cuid())
  menuItemId String
  menuItem   MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  position   Int           @default(0)

  @@unique([menuItemId, groupId])
  @@index([groupId])
}

model Modifier {
  id                String        @id @default(cuid())
  groupId           String
  group             ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name              String
  priceDelta        Decimal       @default(0) @db.Decimal(10, 2)
  // Добавить ингредиент сверх рецепта (доп. сироп, доп. шот) — addQuantity в
  // единицах addProduct.unit.
  addProductId      String?
  addProduct        Product?      @relation("ModifierAdd", fields: [addProductId], references: [id], onDelete: Restrict)
  addQuantity       Decimal?      @db.Decimal(10, 3)
  // Заменить/убрать ингредиент рецепта (растительное молоко вместо коровьего,
  // без сахара).
  replacesProductId String?
  replacesProduct   Product?      @relation("ModifierReplace", fields: [replacesProductId], references: [id], onDelete: Restrict)
  position          Int           @default(0)
  isActive          Boolean       @default(true)

  @@index([groupId, position])
}

// Рецепт: владелец — РОВНО ОДИН из menuItemId / ownerProductId (рецепт блюда
// либо рецепт полуфабриката — см. CHECK-constraint, дописанный вручную в
// миграцию). Ингредиент — всегда обычный Product (сам может быть
// isSemiFinished). quantity — в единицах product.unit.
model RecipeLine {
  id             String    @id @default(cuid())
  menuItemId     String?
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ownerProductId String?
  ownerProduct   Product?  @relation("SemiProductRecipe", fields: [ownerProductId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation("RecipeIngredient", fields: [productId], references: [id], onDelete: Restrict)
  quantity       Decimal   @db.Decimal(10, 3)
  createdAt      DateTime  @default(now())

  @@unique([menuItemId, productId])
  @@unique([ownerProductId, productId])
  @@index([productId])
}

// Заказ — «открытая комната» до оплаты, НЕ чек. Sale создаётся только в
// момент оплаты (server/services/horeca/orders.ts::payOrder), через
// createSaleRecord — единственную точку создания Sale в проекте.
model Order {
  id          String      @id @default(cuid())
  number      Int         @default(autoincrement())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status      OrderStatus @default(OPEN)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  employeeId  String?
  employee    Employee?   @relation(fields: [employeeId], references: [id])
  comment     String?
  createdAt   DateTime    @default(now())
  paidAt      DateTime?
  cancelledAt DateTime?
  saleId      String?     @unique
  sale        Sale?       @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items       OrderItem[]

  @@index([storeId, status])
  @@index([storeId, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  // Снимок названия на момент добавления в заказ — блюдо может быть
  // переименовано/снято с меню позже, чек должен остаться читаемым.
  nameAtSale  String
  quantity    Decimal  @db.Decimal(10, 3)
  // Цена блюда + Σ priceDelta выбранных модификаторов, за единицу.
  priceAtSale Decimal  @db.Decimal(10, 2)
  // Снимок MenuItem.cachedCost на момент продажи — для аналитики прибыли.
  costAtSale  Decimal  @db.Decimal(10, 2)
  // [{modifierId,name,priceDelta,addProductId,addQuantity,replacesProductId}]
  // ВНИМАНИЕ: ключи addProductId/replacesProductId здесь проверяются
  // tenant-изоляцией (server/tenant.ts::collectFks рекурсивно обходит Json) —
  // не переименовывать без синхронной правки FK_TARGETS.
  modifiers   Json?
  comment     String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([menuItemId])
}

// Документ производства полуфабриката: «замесили 8кг теста» — списывает
// сырьё по СОБСТВЕННОМУ рецепту полуфабриката (Product.ownRecipe), начисляет
// сток самого полуфабриката. В отличие от кассы — недостача здесь блокирует
// проведение (бэк-офис, не гость у кассы).
model ProductionDoc {
  id        String           @id @default(cuid())
  number    Int              @default(autoincrement())
  storeId   String
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Decimal          @db.Decimal(10, 3)
  unitCost  Decimal          @db.Decimal(10, 2)
  totalCost Decimal          @db.Decimal(10, 2)
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  comment   String?
  createdAt DateTime         @default(now())
  lines     ProductionLine[]

  @@index([storeId, createdAt])
}

model ProductionLine {
  id              String        @id @default(cuid())
  productionDocId String
  doc             ProductionDoc @relation(fields: [productionDocId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity        Decimal       @db.Decimal(10, 3)
  costAtMoment    Decimal       @db.Decimal(10, 2)

  @@index([productionDocId])
}
