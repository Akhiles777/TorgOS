# Скопируйте в .env рядом с docker-compose.yml и задайте секреты.
#   cp .env.production.example .env
# ВНИМАНИЕ: .env не коммитить.

# --- База данных ---
POSTGRES_USER=torgos
# Сильный пароль (обязательно смените!):
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=redstore

# --- Приложение ---
# Секрет для подписи/хеша сессий. Сгенерировать: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_48
# Внешний порт, на котором будет доступно приложение (за ним ставьте nginx+TLS)
APP_PORT=3000

# --- Бэкапы ---
BACKUP_INTERVAL=86400   # период бэкапа, сек (86400 = раз в сутки)
BACKUP_KEEP=14          # сколько последних копий хранить

# --- ИИ-сводка владельца (routerai.ru) ---
# Необязательно: без ключа секция «Сводка от ИИ» просто не показывается,
# честные рекомендации-правила работают независимо от неё.
ROUTERAI_API_KEY=
ROUTERAI_MODEL=anthropic/claude-sonnet-5
# Необязательно: модель для определения товара по штрихкоду («Сканирование ИИ»
# в разделе «Быстрое добавление» и «Найти по ИИ» на кассе). Штрихкод сам по
# себе ничего не значит без поиска в интернете, поэтому по умолчанию берётся
# perplexity/sonar — она ищет в сети, честно отвечает «не найдено» вместо
# выдумывания и при этом самая дешёвая в линейке (sonar-pro-search на живом
# сравнении дал тот же результат в разы дороже). Оставьте пустым; менять имеет
# смысл только на другую модель С ВЕБ-ПОИСКОМ — обычные LLM без поиска
# уверенно придумывают неверные названия. Прежде чем платить за поиск, товар
# ищется в бесплатном справочнике barcode-list.ru — для российских товаров он
# закрывает большинство случаев, и до этих моделей дело просто не доходит.
ROUTERAI_BARCODE_MODEL=
# Второй, углублённый заход — только по тому, что не нашлось первым.
ROUTERAI_BARCODE_MODEL_DEEP=
# Дешёвая модель без веб-поиска: приводит найденное в справочнике название
# («ТЕТР 96Л МИКС7922») к виду ценника. Не задано — amazon/nova-micro-v1.
# Если она недоступна, название приводится локальными правилами, без ИИ.
ROUTERAI_BARCODE_MODEL_TIDY=

# --- Поисковая оптимизация ---
# Адрес сайта. Подставляется в canonical, og:url, sitemap.xml и robots.txt —
# если он неверный, поисковик считает страницы дублями и хуже их ранжирует.
NEXT_PUBLIC_SITE_URL=https://torgos.ru
# Коды подтверждения прав на сайт. Взять: Яндекс.Вебмастер (webmaster.yandex.ru)
# и Google Search Console — там же потом видно, по каким запросам приходят люди.
# Вставлять только значение content="…", не весь тег. Пусто — тег не выводится.
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# --- Камеры ---
# Ключ шифрования паролей регистраторов (AES-256-GCM). Сгенерировать: openssl rand -base64 32
# Обязателен — потеряете ключ, все сохранённые пароли регистраторов станут
# невосстановимыми, придётся вводить заново.
CAMERA_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# --- Email (отправка писем: подтверждение регистрации и т.п.) ---
# Пароль — не обычный пароль от почты, а пароль приложения (App Password),
# создаётся отдельно в настройках почтового провайдера.
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USER=CHANGE_ME_your_email@yandex.ru
EMAIL_PASS=CHANGE_ME_app_password

