# Скопируйте в .env рядом с docker-compose.yml и задайте секреты.
#   cp .env.production.example .env
# ВНИМАНИЕ: .env не коммитить.

# --- База данных ---
POSTGRES_USER=torgos
# Сильный пароль (обязательно смените!):
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=redstore

# --- Приложение ---
# Секрет для подписи/хеша сессий. Сгенерировать: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_48
# Внешний порт, на котором будет доступно приложение (за ним ставьте nginx+TLS)
APP_PORT=3000

# --- Бэкапы ---
BACKUP_INTERVAL=86400   # период бэкапа, сек (86400 = раз в сутки)
BACKUP_KEEP=14          # сколько последних копий хранить

# --- ИИ-сводка владельца (routerai.ru) ---
# Необязательно: без ключа секция «Сводка от ИИ» просто не показывается,
# честные рекомендации-правила работают независимо от неё.
ROUTERAI_API_KEY=
ROUTERAI_MODEL=anthropic/claude-sonnet-5
# Необязательно: модель для определения товара по штрихкоду («Сканирование ИИ»
# в разделе «Быстрое добавление» и «Найти по ИИ» на кассе). Штрихкод сам по
# себе ничего не значит без поиска в интернете, поэтому по умолчанию берётся
# perplexity/sonar-pro-search — она ищет в сети и честно отвечает «не найдено»
# вместо выдумывания. Оставьте пустым, если не нужна другая модель; менять
# имеет смысл только на другую модель С ВЕБ-ПОИСКОМ (обычные LLM без поиска
# уверенно придумывают неверные названия).
ROUTERAI_BARCODE_MODEL=

# --- Камеры ---
# Ключ шифрования паролей регистраторов (AES-256-GCM). Сгенерировать: openssl rand -base64 32
# Обязателен — потеряете ключ, все сохранённые пароли регистраторов станут
# невосстановимыми, придётся вводить заново.
CAMERA_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# --- Email (отправка писем: подтверждение регистрации и т.п.) ---
# Пароль — не обычный пароль от почты, а пароль приложения (App Password),
# создаётся отдельно в настройках почтового провайдера.
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USER=CHANGE_ME_your_email@yandex.ru
EMAIL_PASS=CHANGE_ME_app_password

